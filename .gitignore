# ── Personal configuration (never commit) ────────────────────────────────────
config.local.yaml

# ── Pipeline runtime outputs (all derived — nothing under these is tracked) ──
# data/fold_inputs/         preprocessing: fold_input(.resolved).json per complex
# data/synthetic_templates/ scripts/select_synthetic_templates.py: donor snapshot,
#                           template PDBs copied from results/, manifest
data/
results/
logs/

# ── Snakemake internals ───────────────────────────────────────────────────────
.snakemake/
*.snakemake.log

# ── Conda environments (built automatically by Snakemake) ────────────────────
.conda/

# ── Vendored external tools (cloned separately) ──────────────────────────────
tools/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Editors ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
