"""
Snakefile_preprocess — Stage 1
================================
Run locally (needs internet for stage 1b). Prepares all inputs needed for
ABCfold (https://github.com/rigdenlab/ABCFold) to run AlphaFold3, Boltz-2,
Chai-1, OpenFold3, Protenix and RosettaFold3 together.

  1a. Fold input — fold_input.json per complex (every replica seed inside),
      AlphaFold3-dialect JSON, ABCfold's own native input format
  1b. MMseqs2    — "default run" MSA + top-hit templates from the ColabFold
      default run  webserver (no manual curation, no pocket restraint),
                   fetched once per complex via ABCfold's own `mmseqs2msa`
                   CLI and embedded into fold_input.json so every backend
                   has everything it needs offline.

Sequences are static (copied from the old project's AF3-webserver
job_request.json files — see configs/<complex>.yaml), so unlike
ABCfold_NPF_pipeline there is no UniProt download checkpoint and no
apo/holo split — every complex here is a fixed multi-chain assembly, not a
single protein with an optional co-folded ligand.

Interface to processing stage:
  data/fold_inputs/{complex}/fold_input.resolved.json

Usage:
  snakemake -s workflows/preprocessing/Snakefile --cores 4 --use-conda
"""

from pathlib import Path

import yaml

configfile: "config.yaml"

if Path("config.local.yaml").exists():

    configfile: "config.local.yaml"


DIRS = config["dirs"]
FOLD_INPUTS_DIR = Path(DIRS["fold_inputs"])
LOG_DIR = Path(DIRS["logs"])
AF3_CFG = config["af3"]
MMSEQS_CFG = config["mmseqs2"]
COMPLEXES = config["complexes"]


def synthtmpl_cfg(complex_name: str) -> dict | None:
    """The `synthetic_template:` block of a generated *_synthtmpl_* config, or
    None for a normal complex. These are AF3+OpenFold3 re-runs of the full
    DCL4 complex that reuse an existing complex's MSAs and only differ by a
    custom template injected on DRB2/DRB4 -- so they skip fetch_mmseqs2_msa
    entirely (see rule resolve_synthtmpl) instead of re-hitting the ColabFold
    webserver for identical sequences."""
    path = Path(f"configs/{complex_name}.yaml")
    if not path.exists():
        if "_synthtmpl_" in complex_name:
            raise FileNotFoundError(
                f"{path} is missing -- run "
                f"`python scripts/select_synthetic_templates.py` to generate the "
                f"*_synthtmpl_* configs before preprocessing."
            )
        return None
    return yaml.safe_load(path.read_text()).get("synthetic_template")


SYNTHTMPL = [c for c in COMPLEXES if synthtmpl_cfg(c) is not None]


rule prepare_af3_input:
    input:
        complex_config="configs/{complex}.yaml",
    output:
        json=str(FOLD_INPUTS_DIR / "{complex}" / "fold_input.json"),
    log:
        str(LOG_DIR / "af3_input" / "{complex}.log"),
    conda:
        "../../envs/preprocessing.yaml"
    params:
        n_replicas=AF3_CFG["n_replicas"],
        seed_strategy=AF3_CFG["seed_strategy"],
        seed_base=AF3_CFG["seed_base"],
        random_master_seed=AF3_CFG["random_master_seed"],
        dialect=AF3_CFG["dialect"],
        json_version=AF3_CFG["json_version"],
    shell:
        """
        python scripts/make_multimer_af3_input.py \\
        --complex-config {input.complex_config} \\
        --output {output.json} \\
        --n-replicas {params.n_replicas} \\
        --seed-strategy {params.seed_strategy} \\
        --seed-base {params.seed_base} \\
        --random-master-seed {params.random_master_seed} \\
        --dialect {params.dialect} \\
        --json-version {params.json_version} \\
        >{log} 2>&1
        """


rule fetch_mmseqs2_msa:
    # *_synthtmpl_* complexes are resolved by rule resolve_synthtmpl instead
    # (same sequences as an existing complex -> reuse its MSAs, no webserver
    # call). The negative lookahead keeps the two rules' shared output path
    # unambiguous without a ruleorder.
    wildcard_constraints:
        complex=r"(?!.*_synthtmpl_).+",
    input:
        json=str(FOLD_INPUTS_DIR / "{complex}" / "fold_input.json"),
    output:
        resolved=str(FOLD_INPUTS_DIR / "{complex}" / "fold_input.resolved.json"),
    log:
        str(LOG_DIR / "mmseqs2_msa" / "{complex}.log"),
    conda:
        "../../envs/preprocessing.yaml"
    params:
        num_templates=MMSEQS_CFG["num_templates"],
        retries=MMSEQS_CFG["retries"],
        delay=MMSEQS_CFG["delay"],
    shell:
        """
        python scripts/fetch_mmseqs2_msa.py \\
        --input-json {input.json} \\
        --output-json {output.resolved} \\
        --num-templates {params.num_templates} \\
        --retries {params.retries} \\
        --delay {params.delay} \\
        >{log} 2>&1
        """


def _synthtmpl_donor(wildcards):
    # A frozen snapshot of the donor complex's resolved JSON, taken by
    # scripts/select_synthetic_templates.py -- a plain file, not a rule output,
    # so adding *_synthtmpl_* complexes never causes the baseline donor to be
    # re-resolved against the ColabFold webserver.
    return synthtmpl_cfg(wildcards.complex)["donor_resolved_json"]


def _synthtmpl_template_pdb(wildcards):
    return synthtmpl_cfg(wildcards.complex)["template_pdb"]


def _synthtmpl_manifest(wildcards):
    return str(Path(synthtmpl_cfg(wildcards.complex)["template_pdb"]).parent
               / "templates_manifest.tsv")


rule resolve_synthtmpl:
    # Build fold_input.resolved.json for a *_synthtmpl_* re-run: take the MSA
    # donor's resolved JSON, retitle it, strip the ColabFold templates from
    # the mapped chains, and inject the Chai-1/Boltz DRB2+DRB4 conformation as
    # an AF3-dialect custom template (consumed by both AF3 and OpenFold3).
    # `template_pdb` / `templates_manifest.tsv` are produced out-of-band by
    # scripts/select_synthetic_templates.py -- a missing-input error here means
    # "run that selector first".
    wildcard_constraints:
        complex=r".*_synthtmpl_.*",
    input:
        fold_json=str(FOLD_INPUTS_DIR / "{complex}" / "fold_input.json"),
        donor=_synthtmpl_donor,
        template_pdb=_synthtmpl_template_pdb,
        manifest=_synthtmpl_manifest,
        complex_config="configs/{complex}.yaml",
    output:
        resolved=str(FOLD_INPUTS_DIR / "{complex}" / "fold_input.resolved.json"),
    log:
        str(LOG_DIR / "resolve_synthtmpl" / "{complex}.log"),
    conda:
        "../../envs/preprocessing.yaml"
    params:
        target_ids=lambda wc: " ".join(synthtmpl_cfg(wc.complex)["mapping"].keys()),
        template_chains=lambda wc: " ".join(synthtmpl_cfg(wc.complex)["mapping"].values()),
        strip=lambda wc: " ".join(synthtmpl_cfg(wc.complex).get("strip_colabfold_templates", [])),
    shell:
        """
        python scripts/inject_synthetic_template.py \\
        --donor-resolved-json {input.donor} \\
        --target-fold-json {input.fold_json} \\
        --template-pdb {input.template_pdb} \\
        --target-ids {params.target_ids} \\
        --template-chains {params.template_chains} \\
        --strip-target-templates {params.strip} \\
        --output-json {output.resolved} \\
        >{log} 2>&1
        """


rule all:
    default_target: True
    input:
        expand(str(FOLD_INPUTS_DIR / "{complex}" / "fold_input.resolved.json"), complex=COMPLEXES),
