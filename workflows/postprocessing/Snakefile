        csvs=summaries_for_complex_drb2_drb4,
    output:
        str(POSTPROC_DIR / "{complex}" / "all_selected_summary_drb2_drb4.csv"),
    conda:
        "../../envs/aggregate.yaml"
    log:
        str(LOG_DIR / "{complex}" / "aggregate_drb2_drb4.log"),
    shell:
        """
        python scripts/aggregate_summaries.py --output {output} {input.csvs} > {log} 2>&1
        """


rule all:
    default_target: True
    input:
        expand(str(POSTPROC_DIR / "{complex}" / "all_selected_summary.csv"), complex=COMPLEXES),
        expand(str(POSTPROC_DIR / "{complex}" / "all_selected_summary_rna_ligands.csv"), complex=RNA_LIGAND_COMPLEXES),
        expand(str(POSTPROC_DIR / "{complex}" / "all_selected_summary_drb2_drb4.csv"), complex=DRB2_DRB4_COMPLEXES),
